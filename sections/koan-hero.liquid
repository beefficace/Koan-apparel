<div class="koan-hero page-width">
  <div class="koan-hero__container">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3000 | image_tag: class: 'koan-hero__image', loading: 'lazy' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'koan-hero__image placeholder-svg' }}
    {%- endif -%}

    <div class="koan-hero__overlay"></div>

    <div class="koan-hero__content">
      <div class="koan-hero__box">
        <p class="koan-hero__subtitle">{{ section.settings.subtitle | default: "Collection Automne/Hiver" }}</p>
        <h1 class="koan-hero__title">{{ section.settings.heading | default: "Élégance essentielle" }}</h1>
        <a href="{{ section.settings.button_link | default: collections.all.url }}" class="button koan-hero__button">
          {{ section.settings.button_label | default: "Découvrir la collection" }}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .koan-hero {
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    max-width: 100%;
  }

  .koan-hero__container {
    position: relative;
    width: 100%;
    height: 90vh; /* Full height impact */
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: none; /* Reset from previous brutalist style */
  }

  .koan-hero__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .koan-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.2); /* Light black overlay for readability */
    z-index: 1;
  }

  .koan-hero__content {
    position: relative;
    z-index: 2;
    max-width: 120rem;
    padding: 2rem;
    text-align: center;
    width: 100%;
  }

  .koan-hero__box {
    background: transparent; /* No box */
    border: none;
    box-shadow: none;
    padding: 0;
  }

  .koan-hero__title {
    font-family: "Playfair Display", "Times New Roman", serif;
    font-weight: 400; /* Light/Regular */
    font-size: 8rem; /* Gigantic */
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 3rem 0;
    letter-spacing: 0;
    text-transform: none; /* Sentence case */
  }

  .koan-hero__subtitle {
    font-family: "Inter", "Helvetica", sans-serif;
    font-size: 1.6rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .koan-hero__button.button {
    background-color: #FFFFFF;
    color: #000000;
    border: none;
    border-radius: 50px; /* Pill shape */
    padding: 1.5rem 4rem;
    font-family: "Inter", sans-serif;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: transform 0.3s ease, background-color 0.3s ease;
    box-shadow: none;
  }

  .koan-hero__button.button:hover {
    transform: scale(1.05);
    background-color: #F0F0F0;
    color: #000000;
    box-shadow: none;
  }

  @media screen and (max-width: 749px) {
    .koan-hero__container {
      height: 70vh;
      min-height: 500px;
    }
    .koan-hero__title {
      font-size: 4.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Koan Hero (Premium)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Élégance essentielle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "COLLECTION AUTOMNE/HIVER"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Découvrir la collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "Koan Hero (Premium)"
    }
  ]
}
{% endschema %}
