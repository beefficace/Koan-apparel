<div class="koan-hero page-width">
  <div class="koan-hero__container">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3000 | image_tag: class: 'koan-hero__image', loading: 'lazy' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'koan-hero__image placeholder-svg' }}
    {%- endif -%}

    <div class="koan-hero__content">
      <div class="banner__box koan-hero__box">
        <h1 class="koan-hero__title">{{ section.settings.heading | default: "LA SAGESSE DE LA RUE" }}</h1>
        <p class="koan-hero__subtitle">{{ section.settings.subtitle | default: "PAS DE LOGOS VIDES. JUSTE DES VÉRITÉS BRUTES. STREETWEAR ÉTHIQUE POUR LES ESPRITS LIBRES." }}</p>
        <a href="{{ section.settings.button_link | default: collections.all.url }}" class="button koan-hero__button">
          {{ section.settings.button_label | default: "TROUVE TON KOAN" }}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .koan-hero {
    margin-top: 3rem;
    margin-bottom: 3rem;
  }

  .koan-hero__container {
    position: relative;
    width: 100%;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #000000; /* Brutal Border for image container too */
    overflow: hidden;
  }

  .koan-hero__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .koan-hero__content {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    padding: 2rem;
    text-align: center;
  }

  /* Reusing global banner__box styles but enforcing specific overrides if needed */
  .koan-hero__box {
    text-align: center;
  }

  .koan-hero__title {
    font-family: "Impact", "Oswald", sans-serif;
    text-transform: uppercase;
    font-size: 5rem;
    line-height: 0.9;
    margin-bottom: 1.5rem;
    color: #000000;
  }

  .koan-hero__subtitle {
    font-family: "Courier New", monospace;
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 2.5rem;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media screen and (max-width: 749px) {
    .koan-hero__container {
      min-height: 400px;
    }
    .koan-hero__title {
      font-size: 3rem;
    }
  }
</style>

{% schema %}
{
  "name": "Koan Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "LA SAGESSE DE LA RUE"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "PAS DE LOGOS VIDES. JUSTE DES VÉRITÉS BRUTES. STREETWEAR ÉTHIQUE POUR LES ESPRITS LIBRES."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "TROUVE TON KOAN"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "Koan Hero"
    }
  ]
}
{% endschema %}
