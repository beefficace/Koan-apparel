{{ 'koan-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'koan-header.js' | asset_url }}" defer="defer"></script>

<header class="koan-header {% if section.settings.transparent_on_top %}koan-header--transparent{% else %}koan-header--solid{% endif %}" data-transparent="{{ section.settings.transparent_on_top }}">
  <div class="koan-header__container">

    <!-- Left: Hamburger -->
    <div class="koan-header__left">
      <button class="hamburger-btn js-hamburger-toggle" aria-label="Menu" aria-expanded="false" aria-controls="KoanMenuOverlay">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>

    <!-- Center: Logo -->
    <div class="koan-header__center">
      <a href="{{ routes.root_url }}" class="koan-logo-link">
        {% if section.settings.logo != blank %}
          {% assign logo_width = section.settings.logo_width %}
          {% assign logo_width_2x = logo_width | times: 2 %}
          <img
            src="{{ section.settings.logo | image_url: width: logo_width }}"
            srcset="{{ section.settings.logo | image_url: width: logo_width }} 1x, {{ section.settings.logo | image_url: width: logo_width_2x }} 2x"
            alt="{{ section.settings.logo.alt | default: shop.name }}"
            class="koan-logo-img"
            style="width: {{ logo_width }}px;"
            width="{{ logo_width }}"
            height="{{ section.settings.logo.height }}"
          >
        {% else %}
          <span class="koan-logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Right: Icons -->
    <div class="koan-header__right">
      <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Search">
        <svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="Cart">
        <svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">({{ cart.item_count }})</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

<!-- Full Screen Menu Overlay -->
<div class="koan-menu-overlay" id="KoanMenuOverlay" aria-hidden="true">
  <nav>
    <ul class="koan-menu-list">
      {% for link in section.settings.menu.links %}
        <li class="koan-menu-item">
          <a href="{{ link.url }}" class="koan-menu-link">
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      "logo": {{ section.settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header (Koan)",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Main Menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_top",
      "default": true,
      "label": "Transparent background at top",
      "info": "Header will become solid when scrolling down."
    }
  ],
  "presets": [
    {
      "name": "Header (Koan)"
    }
  ]
}
{% endschema %}
